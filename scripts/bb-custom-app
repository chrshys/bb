#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
repo_root="$(dirname -- "${script_dir}")"
node_runtime_default="${HOME}/.cache/bb-node-22.19.0/node_modules/.bin"
install_path="/Applications/bb Custom.app"
built_app="${repo_root}/apps/desktop/release/mac-arm64/bb Custom.app"

usage() {
  cat <<'EOF'
Usage: scripts/bb-custom-app <command>

  dev       Start the checkout-isolated source server and Electron app with HMR.
  stop      Stop the checkout-isolated development instance.
  build     Build an ad-hoc-signed, unpacked bb Custom.app.
  install   Build and atomically install /Applications/bb Custom.app.
  switch    Quit stock bb and launch the installed bb Custom app.
  status    Show development and installed-app status.

The custom packaged app uses the normal ~/.bb data directory and ports. Do not
run stock bb and bb Custom simultaneously. Upstream desktop updates are disabled
in custom-channel builds.
EOF
}

prepare_runtime() {
  if [[ -d "${BB_CUSTOM_NODE_BIN:-}" ]]; then
    PATH="${BB_CUSTOM_NODE_BIN}:${PATH}"
  elif [[ -d "${node_runtime_default}" ]]; then
    PATH="${node_runtime_default}:${PATH}"
  fi
  export PATH

  command -v node >/dev/null 2>&1 || {
    echo "Node is required." >&2
    exit 1
  }
  if ! node -e '
    const [major, minor] = process.versions.node.split(".").map(Number);
    process.exit(major === 22 && minor >= 19 ? 0 : 1);
  '; then
    echo "bb desktop builds require Node 22.19 or newer in the Node 22 line." >&2
    echo "Set BB_CUSTOM_NODE_BIN to a directory containing a compatible node binary." >&2
    exit 1
  fi
  command -v pnpm >/dev/null 2>&1 || {
    echo "pnpm is required." >&2
    exit 1
  }
}

custom_is_running() {
  pgrep -f '/Applications/bb Custom\.app/Contents/MacOS/' >/dev/null 2>&1
}

stock_is_running() {
  pgrep -f '/Applications/bb\.app/Contents/MacOS/' >/dev/null 2>&1
}

build_custom() {
  prepare_runtime
  cd "${repo_root}"
  pnpm install --frozen-lockfile
  BB_DESKTOP_RELEASE_CHANNEL=custom \
    BB_DESKTOP_ADHOC_SIGNING=true \
    pnpm --filter @bb/desktop run package
  [[ -d "${built_app}" ]] || {
    echo "Expected build output was not created: ${built_app}" >&2
    exit 1
  }
  echo "Built ${built_app}"
}

install_custom() {
  if custom_is_running; then
    echo "Quit bb Custom before reinstalling it." >&2
    exit 1
  fi
  build_custom

  local staging_path="/Applications/.bb Custom.app.install-$$"
  trap 'rm -rf -- "${staging_path}"' EXIT
  rm -rf -- "${staging_path}"
  ditto "${built_app}" "${staging_path}"
  rm -rf -- "${install_path}"
  mv "${staging_path}" "${install_path}"
  trap - EXIT
  xattr -dr com.apple.quarantine "${install_path}" 2>/dev/null || true
  echo "Installed ${install_path}"
  echo "Run 'scripts/bb-custom-app switch' from a normal Terminal to make it active."
}

switch_to_custom() {
  [[ -d "${install_path}" ]] || {
    echo "${install_path} is not installed; run the install command first." >&2
    exit 1
  }
  if stock_is_running; then
    osascript -e 'tell application id "dev.bb.desktop" to quit' >/dev/null
  fi

  local elapsed=0
  while lsof -nP -iTCP:38886 -sTCP:LISTEN >/dev/null 2>&1; do
    if (( elapsed >= 30 )); then
      echo "Timed out waiting for port 38886 after quitting stock bb." >&2
      exit 1
    fi
    sleep 1
    elapsed=$((elapsed + 1))
  done

  open "${install_path}"
  echo "Launched ${install_path}"
}

status() {
  prepare_runtime
  cd "${repo_root}"
  scripts/bb-dev-app status
  printf 'Installed custom app: %s\n' "$( [[ -d "${install_path}" ]] && echo yes || echo no )"
  printf 'Stock app running: %s\n' "$( stock_is_running && echo yes || echo no )"
  printf 'Custom app running: %s\n' "$( custom_is_running && echo yes || echo no )"
}

command="${1:-}"
case "${command}" in
  dev)
    prepare_runtime
    cd "${repo_root}"
    exec scripts/bb-dev-app current --desktop
    ;;
  stop)
    prepare_runtime
    cd "${repo_root}"
    exec scripts/bb-dev-app stop
    ;;
  build)
    build_custom
    ;;
  install)
    install_custom
    ;;
  switch)
    switch_to_custom
    ;;
  status)
    status
    ;;
  help|-h|--help|"")
    usage
    ;;
  *)
    echo "Unknown command: ${command}" >&2
    usage >&2
    exit 1
    ;;
esac
