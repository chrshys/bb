#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
script_path="${script_dir}/$(basename -- "${BASH_SOURCE[0]}")"
repo_root="$(dirname -- "${script_dir}")"
install_path="/Applications/sf-bb.app"
legacy_install_path="/Applications/bb Custom.app"
built_app="${repo_root}/apps/desktop/release/mac-arm64/sf-bb.app"
deploy_log="${HOME}/Library/Logs/sf-bb-deploy.log"
release_feed_url="https://github.com/chrshys/bb/releases/download/desktop-sf-bb/desktop-version.json"
support_dir="${HOME}/Library/Application Support/sf-bb"
pending_update_file="${support_dir}/pending-update"
update_lock_dir="${support_dir}/update.lock"
update_log="${HOME}/Library/Logs/sf-bb-update.log"
launch_agent_label="dev.bb.desktop.sf-bb.update"
launch_agent_plist="${HOME}/Library/LaunchAgents/${launch_agent_label}.plist"
event_log_path=""
cleanup_staging_path=""
cleanup_extract_path=""
cleanup_download_dir=""
cleanup_lock_path=""
cleanup_version_backup_dir=""
cleanup_plist_temp=""

usage() {
  cat <<'EOF'
Usage: scripts/sf-bb <command>

  dev       Start the checkout-isolated source server and Electron app with HMR.
  stop      Stop the checkout-isolated development instance.
  build     Build an ad-hoc-signed, unpacked sf-bb.app.
  install   Build and atomically install /Applications/sf-bb.app.
  deploy    Build, then safely replace/relaunch sf-bb after a short delay.
  update    Download, verify, and install the released sf-bb app.
  schedule  Install, remove, or inspect the periodic update agent.
  switch    Quit stock/legacy BB and launch the installed sf-bb app.
  status    Show development and installed-app status.
  version   Compare the installed bundle, release feed, and running server.

Update options:
  --force          Replace a current, newer, or local build.
  --when idle|now  Stage while running, or replace and relaunch immediately.
  --version <v>    Install a specific sf-bb release version.
  --max-age <hours>  Force an idle update after this age; 0 disables it.

Schedule usage:
  scripts/sf-bb schedule install [--interval <seconds>] [--max-age <hours>]
  scripts/sf-bb schedule remove
  scripts/sf-bb schedule status

The packaged sf-bb app uses the normal ~/.bb data directory and ports. Do not
run stock bb, legacy bb Custom, and sf-bb simultaneously. Local ad-hoc builds
check the public sf-bb release feed but install updates manually.
EOF
}

append_event_log() {
  local message="${1:?log message is required}"
  [[ -n "${event_log_path}" ]] || return 0
  mkdir -p "$(dirname -- "${event_log_path}")"
  printf '[%s] %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "${message}" >> "${event_log_path}"
}

announce() {
  local message="${1:?message is required}"
  if [[ "${BB_SF_BB_STDIO_IS_EVENT_LOG:-}" == "1" ]]; then
    printf '[%s] %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "${message}"
  else
    printf '%s\n' "${message}"
    append_event_log "${message}"
  fi
}

report_error() {
  local message="${1:?error message is required}"
  if [[ "${BB_SF_BB_STDIO_IS_EVENT_LOG:-}" == "1" ]]; then
    printf '[%s] ERROR: %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "${message}" >&2
  else
    printf '%s\n' "${message}" >&2
    append_event_log "ERROR: ${message}"
  fi
}

cleanup_operation_paths() {
  if [[ -n "${cleanup_version_backup_dir}" ]]; then
    cp -p "${cleanup_version_backup_dir}/desktop-package.json" "${repo_root}/apps/desktop/package.json"
    cp -p "${cleanup_version_backup_dir}/bb-app-package.json" "${repo_root}/packages/bb-app/package.json"
    rm -rf -- "${cleanup_version_backup_dir}"
    cleanup_version_backup_dir=""
  fi
  if [[ -n "${cleanup_extract_path}" ]]; then
    rm -rf -- "${cleanup_extract_path}"
  fi
  if [[ -n "${cleanup_staging_path}" ]]; then
    rm -rf -- "${cleanup_staging_path}"
  fi
  if [[ -n "${cleanup_download_dir}" ]]; then
    rm -rf -- "${cleanup_download_dir}"
  fi
  if [[ -n "${cleanup_lock_path}" ]]; then
    rm -f -- "${cleanup_lock_path}/pid"
    rmdir "${cleanup_lock_path}" 2>/dev/null || true
  fi
  if [[ -n "${cleanup_plist_temp}" ]]; then
    rm -f -- "${cleanup_plist_temp}"
  fi
}

describe_version() {
  local version="${1:?version is required}"
  if [[ "${version}" == *-local.* ]]; then
    printf '%s (local build)' "${version}"
  else
    printf '%s' "${version}"
  fi
}

acquire_update_lock() {
  local lock_pid=""
  mkdir -p "${support_dir}"
  if ! mkdir "${update_lock_dir}" 2>/dev/null; then
    if [[ -f "${update_lock_dir}/pid" ]]; then
      IFS= read -r lock_pid < "${update_lock_dir}/pid" || true
    fi
    if [[ "${lock_pid}" =~ ^[0-9]+$ ]] && kill -0 "${lock_pid}" 2>/dev/null; then
      report_error "Another sf-bb update is already running."
      return 1
    fi
    rm -f -- "${update_lock_dir}/pid"
    if ! rmdir "${update_lock_dir}" 2>/dev/null || ! mkdir "${update_lock_dir}" 2>/dev/null; then
      report_error "Another sf-bb update is already running."
      return 1
    fi
  fi
  printf '%s\n' "$$" > "${update_lock_dir}/pid"
  cleanup_lock_path="${update_lock_dir}"
}

node_is_compatible() {
  "$1" -e '
    const [major, minor] = process.versions.node.split(".").map(Number);
    process.exit(major === 22 && minor >= 19 ? 0 : 1);
  '
}

require_build_runtime() {
  local node_bin_dir required_node_version required_pnpm_version pnpm_candidate pnpm_version
  required_node_version="$(tr -d '[:space:]' < "${repo_root}/.nvmrc")"

  if [[ -n "${BB_CUSTOM_NODE_BIN:-}" ]]; then
    if [[ ! -x "${BB_CUSTOM_NODE_BIN}/node" ]]; then
      echo "BB_CUSTOM_NODE_BIN must contain an executable node binary: ${BB_CUSTOM_NODE_BIN}" >&2
      exit 1
    fi
    PATH="${BB_CUSTOM_NODE_BIN}:${PATH}"
  elif command -v volta >/dev/null 2>&1; then
    local volta_node
    volta_node="$(volta run --node "${required_node_version}" -- node -p process.execPath 2>/dev/null || true)"
    if [[ -n "${volta_node}" && -x "${volta_node}" ]]; then
      PATH="$(dirname -- "${volta_node}"):${PATH}"
    fi
  fi
  export PATH

  if ! command -v node >/dev/null 2>&1 || ! node_is_compatible "$(command -v node)"; then
    echo "bb desktop builds require Node 22.19 or newer in the Node 22 line." >&2
    if [[ -n "${BB_CUSTOM_NODE_BIN:-}" ]]; then
      echo "BB_CUSTOM_NODE_BIN does not contain a compatible Node version." >&2
    elif command -v volta >/dev/null 2>&1; then
      echo "Run: volta install node@${required_node_version}" >&2
    else
      echo "Install Node ${required_node_version}, or set BB_CUSTOM_NODE_BIN to its bin directory." >&2
    fi
    exit 1
  fi
  node_bin_dir="$(dirname -- "$(command -v node)")"
  required_pnpm_version="$(node -p 'require(process.argv[1]).packageManager.replace(/^pnpm@/, "")' "${repo_root}/package.json")"
  pnpm_candidate=""
  while IFS= read -r pnpm_candidate; do
    [[ -x "${pnpm_candidate}" ]] || continue
    pnpm_version="$("${pnpm_candidate}" --version 2>/dev/null || true)"
    if [[ "${pnpm_version}" == "${required_pnpm_version}" ]]; then
      PATH="${node_bin_dir}:$(dirname -- "${pnpm_candidate}"):${PATH}"
      export PATH
      return
    fi
  done < <(type -a -p pnpm 2>/dev/null || true)
  echo "bb desktop builds require pnpm ${required_pnpm_version}." >&2
  if command -v corepack >/dev/null 2>&1; then
    echo "Run: corepack prepare pnpm@${required_pnpm_version} --activate" >&2
  else
    echo "Install pnpm ${required_pnpm_version}." >&2
  fi
  return 1
}

compare_semver() {
  local left="${1:?left version is required}"
  local right="${2:?right version is required}"
  local pattern='^([0-9]+)\.([0-9]+)\.([0-9]+)(-([0-9A-Za-z.-]+))?(\+[0-9A-Za-z.-]+)?$'
  local left_major left_minor left_patch left_prerelease
  local right_major right_minor right_patch right_prerelease

  if [[ ! "${left}" =~ ${pattern} ]]; then
    return 2
  fi
  left_major="${BASH_REMATCH[1]}"
  left_minor="${BASH_REMATCH[2]}"
  left_patch="${BASH_REMATCH[3]}"
  left_prerelease="${BASH_REMATCH[5]}"

  if [[ ! "${right}" =~ ${pattern} ]]; then
    return 2
  fi
  right_major="${BASH_REMATCH[1]}"
  right_minor="${BASH_REMATCH[2]}"
  right_patch="${BASH_REMATCH[3]}"
  right_prerelease="${BASH_REMATCH[5]}"

  local index
  local left_number right_number
  for index in 0 1 2; do
    case "${index}" in
      0)
        left_number="${left_major}"
        right_number="${right_major}"
        ;;
      1)
        left_number="${left_minor}"
        right_number="${right_minor}"
        ;;
      *)
        left_number="${left_patch}"
        right_number="${right_patch}"
        ;;
    esac
    if (( 10#${left_number} < 10#${right_number} )); then
      printf '%s' -1
      return
    fi
    if (( 10#${left_number} > 10#${right_number} )); then
      printf '%s' 1
      return
    fi
  done

  if [[ -z "${left_prerelease}" && -z "${right_prerelease}" ]]; then
    printf '%s' 0
    return
  fi
  if [[ -z "${left_prerelease}" ]]; then
    printf '%s' 1
    return
  fi
  if [[ -z "${right_prerelease}" ]]; then
    printf '%s' -1
    return
  fi

  local -a left_identifiers right_identifiers
  local left_identifier right_identifier
  IFS='.' read -r -a left_identifiers <<< "${left_prerelease}"
  IFS='.' read -r -a right_identifiers <<< "${right_prerelease}"
  index=0
  while (( index < ${#left_identifiers[@]} || index < ${#right_identifiers[@]} )); do
    if (( index >= ${#left_identifiers[@]} )); then
      printf '%s' -1
      return
    fi
    if (( index >= ${#right_identifiers[@]} )); then
      printf '%s' 1
      return
    fi
    left_identifier="${left_identifiers[${index}]}"
    right_identifier="${right_identifiers[${index}]}"
    if [[ "${left_identifier}" == "${right_identifier}" ]]; then
      index=$((index + 1))
      continue
    fi
    if [[ "${left_identifier}" =~ ^[0-9]+$ && "${right_identifier}" =~ ^[0-9]+$ ]]; then
      if (( 10#${left_identifier} < 10#${right_identifier} )); then
        printf '%s' -1
      else
        printf '%s' 1
      fi
      return
    fi
    if [[ "${left_identifier}" =~ ^[0-9]+$ ]]; then
      printf '%s' -1
      return
    fi
    if [[ "${right_identifier}" =~ ^[0-9]+$ ]]; then
      printf '%s' 1
      return
    fi
    if [[ "${left_identifier}" < "${right_identifier}" ]]; then
      printf '%s' -1
    else
      printf '%s' 1
    fi
    return
  done
  printf '%s' 0
}

read_json_string() {
  local json="${1:?JSON input is required}"
  local key="${2:?JSON key is required}"
  printf '%s' "${json}" | /usr/bin/plutil -extract "${key}" raw -o - - 2>/dev/null
}

read_json_number() {
  local json="${1:?JSON input is required}"
  local key="${2:?JSON key is required}"
  local value
  value="$(printf '%s' "${json}" | /usr/bin/plutil -extract "${key}" raw -o - - 2>/dev/null)" || return 1
  [[ "${value}" =~ ^[0-9]+$ ]] || return 1
  printf '%s' "${value}"
}

read_bundle_version() {
  local bundle_path="${1:?bundle path is required}"
  local version
  [[ -f "${bundle_path}/Contents/Info.plist" ]] || return 1
  version="$(/usr/libexec/PlistBuddy -c 'Print CFBundleShortVersionString' "${bundle_path}/Contents/Info.plist" 2>/dev/null)" || return 1
  compare_semver "${version}" "${version}" >/dev/null || return 1
  printf '%s' "${version}"
}

print_json_string_or_null() {
  local value="${1:-}"
  if [[ -n "${value}" ]]; then
    printf '"%s"' "${value}"
  else
    printf 'null'
  fi
}

show_version() {
  local output_json=false
  if [[ "${1:-}" == "--json" ]]; then
    output_json=true
  elif [[ -n "${1:-}" ]]; then
    echo "Usage: scripts/sf-bb version [--json]" >&2
    return 2
  fi

  local installed_version=""
  local feed_json feed_version
  local running_json="" running_version=""
  local update_available=true
  local comparison

  if [[ -f "${install_path}/Contents/Info.plist" ]]; then
    installed_version="$(/usr/libexec/PlistBuddy -c 'Print CFBundleShortVersionString' "${install_path}/Contents/Info.plist" 2>/dev/null || true)"
    if [[ -z "${installed_version}" ]] || ! compare_semver "${installed_version}" "${installed_version}" >/dev/null; then
      echo "Could not parse the installed sf-bb version." >&2
      return 2
    fi
  fi

  if ! feed_json="$(curl -fsSL --retry 5 --retry-all-errors "${release_feed_url}?cache-bust=$(date +%s)")"; then
    echo "Could not fetch the sf-bb release feed." >&2
    return 2
  fi
  if ! feed_version="$(read_json_string "${feed_json}" version)" || ! compare_semver "${feed_version}" "${feed_version}" >/dev/null; then
    echo "Could not parse the sf-bb release feed version." >&2
    return 2
  fi

  if lsof -nP -iTCP:38886 -sTCP:LISTEN >/dev/null 2>&1; then
    if ! running_json="$(curl -fsS --connect-timeout 2 --max-time 5 http://127.0.0.1:38886/api/v1/system/version)"; then
      echo "Port 38886 is in use, but the running server version could not be fetched." >&2
      return 2
    fi
    if ! running_version="$(read_json_string "${running_json}" currentVersion)" || ! compare_semver "${running_version}" "${running_version}" >/dev/null; then
      echo "Could not parse the running server version." >&2
      return 2
    fi
  fi

  if [[ -n "${installed_version}" ]]; then
    if ! comparison="$(compare_semver "${feed_version}" "${installed_version}")"; then
      echo "Could not compare the installed and released versions." >&2
      return 2
    fi
    if [[ "${comparison}" != "1" ]]; then
      update_available=false
    fi
  fi

  if [[ "${output_json}" == "true" ]]; then
    printf '{"installedVersion":'
    print_json_string_or_null "${installed_version}"
    printf ',"feedVersion":'
    print_json_string_or_null "${feed_version}"
    printf ',"runningVersion":'
    print_json_string_or_null "${running_version}"
    printf ',"updateAvailable":%s}\n' "${update_available}"
  else
    printf 'Installed bundle: %s\n' "$(if [[ -n "${installed_version}" ]]; then printf 'sf-bb %s' "$(describe_version "${installed_version}")"; else printf 'not installed'; fi)"
    printf 'Release feed: sf-bb %s\n' "${feed_version}"
    printf 'Running server: %s\n' "$(if [[ -n "${running_version}" ]]; then describe_version "${running_version}"; else printf 'not running'; fi)"
    if [[ -n "${running_version}" && "${running_version}" != "${installed_version}" ]]; then
      echo "Running server differs from the installed sf-bb bundle."
    fi
    printf 'Update available: %s\n' "${update_available}"
  fi

  if [[ "${update_available}" == "true" ]]; then
    return 1
  fi
  return 0
}

sf_bb_is_running() {
  if pgrep -x sf-bb >/dev/null 2>&1; then
    return 0
  fi
  port_has_owner 38886 sf-bb || port_has_owner 38887 sf-bb
}

legacy_custom_is_running() {
  pgrep -x 'bb Custom' >/dev/null 2>&1
}

stock_is_running() {
  pgrep -x bb >/dev/null 2>&1
}

port_listener_records() {
  local port="${1:?port is required}"
  local field pid=""
  while IFS= read -r field; do
    case "${field}" in
      p*) pid="${field#p}" ;;
      c*) printf '%s\t%s\n' "${pid}" "${field#c}" ;;
    esac
  done < <(lsof -nP -Fpc -iTCP:"${port}" -sTCP:LISTEN 2>/dev/null || true)
}

port_has_owner() {
  local port="${1:?port is required}"
  local expected_owner="${2:?expected owner is required}"
  local pid owner
  while IFS=$'\t' read -r pid owner; do
    if [[ "${owner}" == "${expected_owner}" ]]; then
      return 0
    fi
  done < <(port_listener_records "${port}")
  return 1
}

port_is_in_use() {
  local port="${1:?port is required}"
  lsof -nP -iTCP:"${port}" -sTCP:LISTEN >/dev/null 2>&1
}

runtime_ports_are_in_use() {
  port_is_in_use 38886 || port_is_in_use 38887
}

ensure_runtime_ports_are_compatible() {
  local port pid owner
  for port in 38886 38887; do
    while IFS=$'\t' read -r pid owner; do
      [[ -n "${owner}" ]] || continue
      if [[ "${owner}" != "sf-bb" ]]; then
        report_error "Port ${port} is held by ${owner} (pid ${pid}); quit it and re-run."
        return 3
      fi
    done < <(port_listener_records "${port}")
  done
}

quit_other_bb_apps() {
  if stock_is_running; then
    osascript -e 'tell application id "dev.bb.desktop" to quit' >/dev/null 2>&1 || true
  fi
  if legacy_custom_is_running; then
    osascript -e 'tell application id "dev.bb.desktop.custom" to quit' >/dev/null 2>&1 || true
  fi
  if sf_bb_is_running; then
    osascript -e 'tell application id "dev.bb.desktop.sf-bb" to quit' >/dev/null 2>&1 || true
  fi
}

quit_sf_bb() {
  if sf_bb_is_running; then
    osascript -e 'tell application id "dev.bb.desktop.sf-bb" to quit' >/dev/null 2>&1 || true
  fi
}

wait_for_runtime_ports() {
  local allow_other_apps="${1:-false}"
  local elapsed=0
  while runtime_ports_are_in_use; do
    if [[ "${allow_other_apps}" != "true" ]]; then
      ensure_runtime_ports_are_compatible || return $?
    fi
    if (( elapsed >= 30 )); then
      report_error "Timed out waiting for BB to release ports 38886 and 38887."
      return 1
    fi
    sleep 1
    elapsed=$((elapsed + 1))
  done
}

read_pending_update_path() {
  local pending_path=""
  [[ -f "${pending_update_file}" ]] || return 1
  IFS= read -r pending_path < "${pending_update_file}" || true
  if [[ ! "${pending_path}" =~ ^/Applications/\.sf-bb\.app\.update-[0-9]+-[0-9]+$ ]] || [[ ! -d "${pending_path}" ]]; then
    report_error "Discarding an invalid sf-bb pending-update record."
    rm -f -- "${pending_update_file}"
    return 1
  fi
  printf '%s' "${pending_path}"
}

clear_pending_update() {
  local expected_path="${1:?expected pending path is required}"
  local pending_path=""
  if pending_path="$(read_pending_update_path 2>/dev/null || true)" && [[ "${pending_path}" == "${expected_path}" ]]; then
    rm -f -- "${pending_update_file}"
  fi
}

write_pending_update() {
  local staging_path="${1:?staging path is required}"
  mkdir -p "${support_dir}"
  umask 077
  printf '%s\n' "${staging_path}" > "${pending_update_file}"
}

max_age_seconds() {
  local hours="${1:?maximum age is required}"
  [[ "${hours}" =~ ^[0-9]+([.][0-9]+)?$ ]] || return 1
  awk -v hours="${hours}" 'BEGIN { printf "%d", int((hours * 3600) + 0.999999) }'
}

pending_update_is_expired() {
  local maximum_seconds="${1:?maximum age in seconds is required}"
  local modified_at now
  [[ "${maximum_seconds}" =~ ^[0-9]+$ ]] || return 1
  (( 10#${maximum_seconds} > 0 )) || return 1
  [[ -f "${pending_update_file}" ]] || return 1
  modified_at="$(stat -f '%m' "${pending_update_file}")" || return 1
  now="$(date +%s)"
  (( 10#${now} - 10#${modified_at} >= 10#${maximum_seconds} ))
}

cleanup_stale_app_paths() {
  local pending_path=""
  local candidate recovery_path=""
  pending_path="$(read_pending_update_path 2>/dev/null || true)"
  shopt -s nullglob
  if [[ ! -e "${install_path}" ]]; then
    for candidate in /Applications/.sf-bb.app.old-*; do
      recovery_path="${candidate}"
      break
    done
  fi
  if [[ -n "${recovery_path}" ]]; then
    mv "${recovery_path}" "${install_path}"
    announce "Recovered ${install_path} from an interrupted replacement."
  fi

  for candidate in /Applications/.sf-bb.app.install-* /Applications/.sf-bb.app.deploy-* /Applications/.sf-bb.app.update-*; do
    if [[ "${candidate}" != "${pending_path}" ]]; then
      rm -rf -- "${candidate}"
    fi
  done
  if [[ -e "${install_path}" ]]; then
    for candidate in /Applications/.sf-bb.app.old-*; do
      rm -rf -- "${candidate}"
    done
  fi
  shopt -u nullglob
}

replace_installed_app() {
  local staging_path="${1:?staging app path is required}"
  local backup_path="$(dirname -- "${install_path}")/.sf-bb.app.old-$(date +%s)-$$"
  local has_backup=false

  if [[ -e "${install_path}" ]]; then
    mv "${install_path}" "${backup_path}"
    has_backup=true
  fi
  if ! mv "${staging_path}" "${install_path}"; then
    if [[ "${has_backup}" == "true" && -e "${backup_path}" ]]; then
      mv "${backup_path}" "${install_path}"
    fi
    report_error "Could not replace ${install_path}; the previous app was restored."
    return 1
  fi
  if [[ "${has_backup}" == "true" ]]; then
    rm -rf -- "${backup_path}"
  fi
}

apply_pending_update_if_idle() {
  local pending_path=""
  if ! pending_path="$(read_pending_update_path 2>/dev/null)"; then
    return 0
  fi
  if sf_bb_is_running; then
    return 0
  fi
  cleanup_staging_path="${pending_path}"
  announce "Applying the staged sf-bb update."
  activate_staged_app "${pending_path}" 0 "${event_log_path}"
  cleanup_staging_path=""
}

validate_release_feed() {
  local feed_json="${1:?release feed JSON is required}"
  local expected_version="${2:-}"
  local version path sha512 size file_path file_sha512

  version="$(read_json_string "${feed_json}" version)" || return 1
  path="$(read_json_string "${feed_json}" path)" || return 1
  sha512="$(read_json_string "${feed_json}" sha512)" || return 1
  file_path="$(read_json_string "${feed_json}" files.0.url)" || return 1
  file_sha512="$(read_json_string "${feed_json}" files.0.sha512)" || return 1
  size="$(read_json_number "${feed_json}" files.0.size)" || return 1
  compare_semver "${version}" "${version}" >/dev/null || return 1
  [[ -z "${expected_version}" || "${version}" == "${expected_version}" ]] || return 1
  [[ "${path}" =~ ^sf-bb-[0-9A-Za-z.+-]+-arm64\.zip$ ]] || return 1
  [[ "${sha512}" =~ ^[0-9A-Za-z+/]{86}==$ ]] || return 1
  [[ "${file_path}" == "${path}" && "${file_sha512}" == "${sha512}" ]] || return 1
  (( 10#${size} > 0 )) || return 1
  printf '%s\t%s\t%s\t%s\n' "${version}" "${path}" "${sha512}" "${size}"
}

verify_release_download() {
  local download_path="${1:?download path is required}"
  local expected_size="${2:?expected size is required}"
  local expected_sha512="${3:?expected SHA-512 is required}"
  local actual_size actual_sha512

  actual_size="$(stat -f '%z' "${download_path}")"
  if [[ "${actual_size}" != "${expected_size}" ]]; then
    report_error "Downloaded size ${actual_size} does not match expected size ${expected_size}."
    return 1
  fi
  actual_sha512="$(openssl dgst -sha512 -binary "${download_path}" | base64 | tr -d '[:space:]')"
  if [[ "${actual_sha512}" != "${expected_sha512}" ]]; then
    report_error "Downloaded SHA-512 does not match the release feed."
    return 1
  fi
}

update_sf_bb() {
  local force=false
  local when=""
  local requested_version=""
  local maximum_age_hours="24" maximum_age_seconds
  local feed_url="${release_feed_url}"
  local feed_json feed_values feed_version feed_path feed_sha512 feed_size
  local installed_version="" pending_path="" pending_version=""
  local comparison download_url download_path
  local staging_path extract_path download_dir
  local -a extracted_entries

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --)
        shift
        ;;
      --force)
        force=true
        shift
        ;;
      --when)
        [[ $# -ge 2 ]] || {
          report_error "--when requires idle or now."
          return 2
        }
        when="$2"
        shift 2
        ;;
      --version)
        [[ $# -ge 2 ]] || {
          report_error "--version requires a semantic version."
          return 2
        }
        requested_version="$2"
        shift 2
        ;;
      --max-age)
        [[ $# -ge 2 ]] || {
          report_error "--max-age requires a number of hours."
          return 2
        }
        maximum_age_hours="$2"
        shift 2
        ;;
      *)
        report_error "Unknown update option: $1"
        return 2
        ;;
    esac
  done

  if [[ -z "${when}" ]]; then
    if [[ -t 0 ]]; then
      when="now"
    else
      when="idle"
    fi
  fi
  if [[ "${when}" != "idle" && "${when}" != "now" ]]; then
    report_error "--when must be idle or now."
    return 2
  fi
  if ! maximum_age_seconds="$(max_age_seconds "${maximum_age_hours}")"; then
    report_error "--max-age must be a non-negative number of hours."
    return 2
  fi
  if [[ -n "${requested_version}" ]]; then
    if ! compare_semver "${requested_version}" "${requested_version}" >/dev/null; then
      report_error "--version must be a semantic version."
      return 2
    fi
    feed_url="https://github.com/chrshys/bb/releases/download/sf-bb-v${requested_version}/desktop-version.json"
  fi

  event_log_path="${update_log}"
  trap cleanup_operation_paths EXIT
  acquire_update_lock
  cleanup_stale_app_paths
  apply_pending_update_if_idle

  if ! feed_json="$(curl -fsSL --retry 5 --retry-all-errors "${feed_url}?cache-bust=$(date +%s)")"; then
    report_error "Could not fetch the sf-bb release feed."
    return 2
  fi
  if ! feed_values="$(validate_release_feed "${feed_json}" "${requested_version}")"; then
    report_error "The sf-bb release feed is invalid."
    return 2
  fi
  IFS=$'\t' read -r feed_version feed_path feed_sha512 feed_size <<< "${feed_values}"

  installed_version="$(read_bundle_version "${install_path}" 2>/dev/null || true)"
  if [[ "${installed_version}" == *-local.* && "${force}" != "true" ]]; then
    report_error "Refusing to replace local build ${installed_version}; re-run with --force."
    return 1
  fi
  pending_path="$(read_pending_update_path 2>/dev/null || true)"
  if [[ -n "${pending_path}" ]]; then
    pending_version="$(read_bundle_version "${pending_path}" 2>/dev/null || true)"
  fi
  if [[ -n "${installed_version}" && "${force}" != "true" ]]; then
    comparison="$(compare_semver "${feed_version}" "${installed_version}")"
    if [[ "${comparison}" != "1" ]]; then
      if [[ -n "${pending_path}" ]]; then
        rm -rf -- "${pending_path}"
        rm -f -- "${pending_update_file}"
      fi
      announce "sf-bb ${installed_version} is already current."
      return 0
    fi
  fi

  if [[ -n "${pending_path}" ]]; then
    if [[ "${when}" == "idle" ]] && sf_bb_is_running && pending_update_is_expired "${maximum_age_seconds}"; then
      when="now"
      announce "WARNING: The staged sf-bb update exceeded ${maximum_age_hours} hours; restarting sf-bb now."
    fi
    if [[ "${pending_version}" == "${feed_version}" && "${force}" != "true" ]]; then
      if [[ "${when}" == "idle" ]]; then
        announce "sf-bb ${feed_version} is already staged, waiting for idle."
        return 0
      fi
      announce "Installing the already staged sf-bb ${feed_version}."
      cleanup_staging_path="${pending_path}"
      activate_staged_app "${pending_path}" 0 "${update_log}"
      cleanup_staging_path=""
      return 0
    fi
    rm -rf -- "${pending_path}"
    rm -f -- "${pending_update_file}"
  fi

  download_dir="$(mktemp -d "${TMPDIR:-/tmp}/sf-bb-update.XXXXXX")"
  cleanup_download_dir="${download_dir}"
  download_path="${download_dir}/${feed_path}"
  download_url="${feed_url%/desktop-version.json}/${feed_path}"
  announce "Downloading sf-bb ${feed_version}."
  if ! curl -fL --silent --show-error --retry 5 --retry-all-errors -C - --output "${download_path}" "${download_url}"; then
    report_error "Could not download ${feed_path}."
    return 2
  fi

  verify_release_download "${download_path}" "${feed_size}" "${feed_sha512}"

  staging_path="/Applications/.sf-bb.app.update-$(date +%s)-$$"
  extract_path="${staging_path}.extract"
  cleanup_staging_path="${staging_path}"
  cleanup_extract_path="${extract_path}"
  mkdir "${extract_path}"
  ditto -x -k "${download_path}" "${extract_path}"
  shopt -s nullglob dotglob
  extracted_entries=("${extract_path}"/*)
  shopt -u nullglob dotglob
  if [[ ${#extracted_entries[@]} -ne 1 || "${extracted_entries[0]}" != "${extract_path}/sf-bb.app" || ! -d "${extracted_entries[0]}" ]]; then
    report_error "The release zip must contain only sf-bb.app at its root."
    return 1
  fi
  mv "${extract_path}/sf-bb.app" "${staging_path}"
  rmdir "${extract_path}"
  cleanup_extract_path=""
  codesign --verify --deep --strict "${staging_path}"
  if [[ "$(read_bundle_version "${staging_path}")" != "${feed_version}" ]]; then
    report_error "The staged app version does not match the release feed."
    return 1
  fi
  xattr -dr com.apple.quarantine "${staging_path}" 2>/dev/null || true

  if [[ "${when}" == "idle" ]] && sf_bb_is_running; then
    write_pending_update "${staging_path}"
    cleanup_staging_path=""
    announce "Staged sf-bb ${feed_version}, waiting for idle."
    return 0
  fi

  activate_staged_app "${staging_path}" 0 "${update_log}"
  cleanup_staging_path=""
}

build_sf_bb() {
  local base_version next_patch local_version short_sha
  require_build_runtime
  cd "${repo_root}"
  pnpm install --frozen-lockfile

  base_version="$(node -p "require('./apps/desktop/package.json').version")"
  next_patch="$(node --input-type=module -e 'import { resolveVersionArgument } from "./scripts/lib/semver.mjs"; process.stdout.write(resolveVersionArgument({ argument: "--patch", currentVersion: process.argv[1], usage: "" }));' "${base_version}")"
  short_sha="$(git rev-parse --short=12 HEAD)"
  if [[ -n "$(git status --porcelain --untracked-files=normal)" ]]; then
    short_sha="${short_sha}-dirty"
  fi
  local_version="${next_patch}-local.$(date -u '+%Y%m%d%H%M%S').${short_sha}"
  cleanup_version_backup_dir="$(mktemp -d "${TMPDIR:-/tmp}/sf-bb-version.XXXXXX")"
  cp -p apps/desktop/package.json "${cleanup_version_backup_dir}/desktop-package.json"
  cp -p packages/bb-app/package.json "${cleanup_version_backup_dir}/bb-app-package.json"
  trap cleanup_operation_paths EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  node scripts/bump-version.mjs "${local_version}"
  BB_DESKTOP_RELEASE_CHANNEL=custom \
    BB_DESKTOP_ADHOC_SIGNING=true \
    pnpm exec turbo run package --filter=@bb/desktop --output-logs=new-only
  [[ -d "${built_app}" ]] || {
    echo "Expected build output was not created: ${built_app}" >&2
    exit 1
  }
  echo "Built ${built_app}"
}

copy_built_app() {
  local destination="$1"
  rm -rf -- "${destination}"
  ditto "${built_app}" "${destination}"
  xattr -dr com.apple.quarantine "${destination}" 2>/dev/null || true
}

install_sf_bb() {
  cleanup_stale_app_paths
  if sf_bb_is_running; then
    echo "Quit sf-bb before reinstalling it, or use the deploy command." >&2
    exit 1
  fi
  build_sf_bb

  local staging_path="/Applications/.sf-bb.app.install-$$"
  cleanup_staging_path="${staging_path}"
  trap cleanup_operation_paths EXIT
  copy_built_app "${staging_path}"
  if sf_bb_is_running; then
    report_error "sf-bb started while the replacement was building; quit it and re-run."
    return 1
  fi
  ensure_runtime_ports_are_compatible
  replace_installed_app "${staging_path}"
  cleanup_staging_path=""
  echo "Installed ${install_path}"
  echo "Run 'scripts/sf-bb switch' from a normal Terminal to make it active."
}

activate_staged_app() {
  local staging_path="${1:?staging app path is required}"
  local delay_seconds="${2:-0}"
  event_log_path="${3:-${event_log_path}}"
  if [[ ! "${staging_path}" =~ ^/Applications/\.sf-bb\.app\.(install|deploy|update)-[0-9]+(-[0-9]+)?$ ]] || [[ ! -d "${staging_path}" ]]; then
    report_error "Refusing to activate an invalid sf-bb staging path."
    return 1
  fi
  cleanup_staging_path="${staging_path}"
  trap cleanup_operation_paths EXIT
  announce "Preparing to activate ${staging_path}."
  sleep "${delay_seconds}"
  ensure_runtime_ports_are_compatible
  quit_sf_bb
  wait_for_runtime_ports
  replace_installed_app "${staging_path}"
  cleanup_staging_path=""
  clear_pending_update "${staging_path}"
  rm -rf -- "${legacy_install_path}"
  xattr -dr com.apple.quarantine "${install_path}" 2>/dev/null || true
  open "${install_path}"
  announce "Deployed and launched ${install_path}."
}

deploy_sf_bb() {
  cleanup_stale_app_paths
  build_sf_bb
  local staging_path="/Applications/.sf-bb.app.deploy-$(date +%s)-$$"
  cleanup_staging_path="${staging_path}"
  trap cleanup_operation_paths EXIT
  copy_built_app "${staging_path}"
  mkdir -p "$(dirname -- "${deploy_log}")"
  local delay_seconds="${BB_SF_BB_DEPLOY_DELAY_SECONDS:-20}"
  event_log_path="${deploy_log}"
  append_event_log "Deployment scheduled for ${staging_path} in ${delay_seconds}s."
  nohup "${BASH_SOURCE[0]}" activate-staged "${staging_path}" "${delay_seconds}" "${deploy_log}" \
    >/dev/null 2>&1 </dev/null &
  cleanup_staging_path=""
  echo "sf-bb deployment scheduled in ${delay_seconds}s (pid $!)."
  echo "The app will restart; log: ${deploy_log}"
}

switch_to_sf_bb() {
  local pending_path=""
  if pending_path="$(read_pending_update_path 2>/dev/null)"; then
    event_log_path="${update_log}"
    activate_staged_app "${pending_path}" 0 "${update_log}"
    return
  fi
  [[ -d "${install_path}" ]] || {
    echo "${install_path} is not installed; run the install command first." >&2
    exit 1
  }
  if sf_bb_is_running && ! stock_is_running && ! legacy_custom_is_running; then
    open "${install_path}"
    echo "sf-bb is already running."
    return
  fi
  quit_other_bb_apps
  wait_for_runtime_ports true
  rm -rf -- "${legacy_install_path}"
  open "${install_path}"
  echo "Launched ${install_path}"
}

install_update_schedule() {
  local interval_seconds="3600"
  local maximum_age_hours="24"
  local plist_temp user_domain

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --interval)
        [[ $# -ge 2 ]] || {
          report_error "--interval requires a number of seconds."
          return 2
        }
        interval_seconds="$2"
        shift 2
        ;;
      --max-age)
        [[ $# -ge 2 ]] || {
          report_error "--max-age requires a number of hours."
          return 2
        }
        maximum_age_hours="$2"
        shift 2
        ;;
      *)
        report_error "Unknown schedule install option: $1"
        return 2
        ;;
    esac
  done

  if [[ ! "${interval_seconds}" =~ ^[1-9][0-9]*$ ]]; then
    report_error "--interval must be a positive integer number of seconds."
    return 2
  fi
  if ! max_age_seconds "${maximum_age_hours}" >/dev/null; then
    report_error "--max-age must be a non-negative number of hours."
    return 2
  fi

  mkdir -p "$(dirname -- "${launch_agent_plist}")" "$(dirname -- "${update_log}")"
  plist_temp="$(mktemp "${launch_agent_plist}.tmp.XXXXXX")"
  cleanup_plist_temp="${plist_temp}"
  trap cleanup_operation_paths EXIT
  plutil -create xml1 "${plist_temp}"
  /usr/libexec/PlistBuddy -c "Add :Label string ${launch_agent_label}" "${plist_temp}"
  /usr/libexec/PlistBuddy -c 'Add :ProgramArguments array' "${plist_temp}"
  /usr/libexec/PlistBuddy -c "Add :ProgramArguments:0 string ${script_path}" "${plist_temp}"
  /usr/libexec/PlistBuddy -c 'Add :ProgramArguments:1 string update' "${plist_temp}"
  /usr/libexec/PlistBuddy -c 'Add :ProgramArguments:2 string --when' "${plist_temp}"
  /usr/libexec/PlistBuddy -c 'Add :ProgramArguments:3 string idle' "${plist_temp}"
  /usr/libexec/PlistBuddy -c 'Add :ProgramArguments:4 string --max-age' "${plist_temp}"
  /usr/libexec/PlistBuddy -c "Add :ProgramArguments:5 string ${maximum_age_hours}" "${plist_temp}"
  /usr/libexec/PlistBuddy -c "Add :StartInterval integer ${interval_seconds}" "${plist_temp}"
  /usr/libexec/PlistBuddy -c 'Add :RunAtLoad bool true' "${plist_temp}"
  /usr/libexec/PlistBuddy -c 'Add :AbandonProcessGroup bool true' "${plist_temp}"
  /usr/libexec/PlistBuddy -c 'Add :EnvironmentVariables dict' "${plist_temp}"
  /usr/libexec/PlistBuddy -c 'Add :EnvironmentVariables:PATH string /usr/bin:/bin:/usr/sbin:/sbin' "${plist_temp}"
  /usr/libexec/PlistBuddy -c 'Add :EnvironmentVariables:BB_SF_BB_STDIO_IS_EVENT_LOG string 1' "${plist_temp}"
  /usr/libexec/PlistBuddy -c "Add :StandardOutPath string ${update_log}" "${plist_temp}"
  /usr/libexec/PlistBuddy -c "Add :StandardErrorPath string ${update_log}" "${plist_temp}"
  chmod 600 "${plist_temp}"
  mv "${plist_temp}" "${launch_agent_plist}"
  cleanup_plist_temp=""

  user_domain="gui/$(id -u)"
  launchctl bootout "${user_domain}/${launch_agent_label}" >/dev/null 2>&1 || launchctl unload "${launch_agent_plist}" >/dev/null 2>&1 || true
  if ! launchctl bootstrap "${user_domain}" "${launch_agent_plist}"; then
    launchctl load "${launch_agent_plist}"
  fi
  launchctl kickstart -k "${user_domain}/${launch_agent_label}"
  printf 'Installed scheduled sf-bb updates from %s.\n' "${script_path}"
  printf 'Interval: %s seconds; forced restart after: %s hours.\n' "${interval_seconds}" "${maximum_age_hours}"
  printf 'Re-run schedule install if this script moves. Log: %s\n' "${update_log}"
}

remove_update_schedule() {
  local user_domain="gui/$(id -u)"
  launchctl bootout "${user_domain}/${launch_agent_label}" >/dev/null 2>&1 || launchctl unload "${launch_agent_plist}" >/dev/null 2>&1 || true
  rm -f -- "${launch_agent_plist}"
  printf 'Removed the sf-bb update schedule.\n'
}

show_update_schedule() {
  local pending_path="" pending_version=""
  if launchctl print "gui/$(id -u)/${launch_agent_label}" >/dev/null 2>&1; then
    printf 'Update agent loaded: yes\n'
  else
    printf 'Update agent loaded: no\n'
  fi
  printf 'Launch agent: %s (%s)\n' "${launch_agent_plist}" "$(if [[ -f "${launch_agent_plist}" ]]; then printf present; else printf missing; fi)"
  if pending_path="$(read_pending_update_path 2>/dev/null)"; then
    pending_version="$(read_bundle_version "${pending_path}" 2>/dev/null || true)"
    printf 'Pending update: %s%s\n' "${pending_path}" "$(if [[ -n "${pending_version}" ]]; then printf ' (%s)' "${pending_version}"; fi)"
  else
    printf 'Pending update: none\n'
  fi
  if [[ -f "${update_log}" ]]; then
    printf 'Recent log: %s\n' "${update_log}"
    tail -n 20 "${update_log}"
  else
    printf 'Recent log: none\n'
  fi
}

manage_update_schedule() {
  local action="${1:-}"
  if [[ "${action}" == "--" ]]; then
    shift
    action="${1:-}"
  fi
  case "${action}" in
    install)
      install_update_schedule "${@:2}"
      ;;
    remove)
      [[ $# -eq 1 ]] || {
        report_error "Usage: scripts/sf-bb schedule remove"
        return 2
      }
      remove_update_schedule
      ;;
    status)
      [[ $# -eq 1 ]] || {
        report_error "Usage: scripts/sf-bb schedule status"
        return 2
      }
      show_update_schedule
      ;;
    *)
      report_error "Usage: scripts/sf-bb schedule install|remove|status"
      return 2
      ;;
  esac
}

status() {
  show_version || true
  printf 'Installed sf-bb: %s\n' "$( [[ -d "${install_path}" ]] && echo yes || echo no )"
  printf 'Stock bb running: %s\n' "$( stock_is_running && echo yes || echo no )"
  printf 'Legacy bb Custom running: %s\n' "$( legacy_custom_is_running && echo yes || echo no )"
  printf 'sf-bb running: %s\n' "$( sf_bb_is_running && echo yes || echo no )"
}

command="${1:-}"
case "${command}" in
  dev)
    require_build_runtime
    cd "${repo_root}"
    exec scripts/bb-dev-app current --desktop
    ;;
  stop)
    require_build_runtime
    cd "${repo_root}"
    exec scripts/bb-dev-app stop
    ;;
  build)
    build_sf_bb
    ;;
  install)
    install_sf_bb
    ;;
  deploy)
    deploy_sf_bb
    ;;
  update)
    update_sf_bb "${@:2}"
    ;;
  schedule)
    manage_update_schedule "${@:2}"
    ;;
  switch)
    switch_to_sf_bb
    ;;
  status)
    status
    ;;
  version)
    show_version "${2:-}"
    ;;
  activate-staged)
    activate_staged_app "${2:-}" "${3:-0}" "${4:-}"
    ;;
  help|-h|--help|"")
    usage
    ;;
  *)
    echo "Unknown command: ${command}" >&2
    usage >&2
    exit 1
    ;;
esac
